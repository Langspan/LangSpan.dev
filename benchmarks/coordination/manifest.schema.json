{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LangSpan coordination benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "arms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "arms": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "worktrees": {
                "$ref": "#/$defs/arm"
              },
              "awareness_only": {
                "$ref": "#/$defs/arm"
              },
              "no_tool": {
                "$ref": "#/$defs/arm"
              },
              "coarse_claims": {
                "$ref": "#/$defs/arm"
              },
              "langspan": {
                "$ref": "#/$defs/arm"
              },
              "comparable_tool": {
                "$ref": "#/$defs/arm"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "default": 600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 4194304
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "default": 600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 4194304
        },
        "assesses": {
          "enum": [
            "diagnostic",
            "integrated_correctness"
          ],
          "default": "diagnostic"
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "versions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "setup": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence_file": {
          "type": "string",
          "minLength": 1,
          "description": "Relative file within this unique run directory; traversal and escapes are rejected."
        }
      }
    }
  }
}

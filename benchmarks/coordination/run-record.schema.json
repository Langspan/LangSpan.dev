{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LangSpan coordination benchmark run record v9",
  "description": "One record per driver run: one arm, task family, session count and seed, including a run the preflight check refused. A value the run did not measure is null, never zero. The runner's raw journal (runner/runs.jsonl) holds the per-command detail. v2: isolated clones, tasks_accepted in place of tasks_completed, no contradictions_reported (notes are evidence, not a verdict), split permission denials, session cost, duration and turns, coordinator scans, the requested model, ignored options and the refused status. v3: worktrees of one repository and one coordinator in the langspan arm (isolation), the tool guard's verdict (tool_check), figures summed over every result line of a session (results, turns), peer_checkout denials, interface notices per session, and the hedge stand-in mode. v4: the discovered_change family (roles changer and dependent), the stagger (stagger_s), auto memory (auto_memory) and, per task, whether an interface notice came before the session's first write (notice_before_write). v5: whether the changer made the interface change (interface_change), with dependents not judged when it did not, and the workaround stand-in mode. v6: the repair round of a trial whose combined result failed (repair), and the cost to a correct result (cost): the run's, the repair's and the total figures, and the cost per accepted task. v7: the context LangSpan's hooks added to the sessions (context_added), per task and per trial, in bytes and estimated tokens per turn. v8: in discovered_change, the stale-name writes admitted and the time from the change to the last stale caller fixed (stale_callers), from the sessions' transcripts and the oracle's definitions. v9: the shared arm, whose sessions all work in one checkout and push to one remote (isolation shared, branch main), and the push attempts and rejections per task and per trial (pushes).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "run_id", "arm", "family", "sessions", "seed", "agent",
    "dry_run", "status", "started_at", "elapsed_s", "total_elapsed_s", "time_limit_s",
    "ignored_options", "isolation", "stagger_s", "auto_memory", "tool_check", "versions", "tasks", "tasks_total",
    "tasks_accepted",
    "integrated_tests", "interface_change", "stale_callers", "merge_conflicts", "semantic_conflicts", "duplicate_work", "stops", "questions",
    "permission_denials", "cost_usd", "turns", "refusals", "pushes", "coordinator_scans", "context_added", "tokens", "repair",
    "cost", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 9},
    "record_type": {"const": "coordination_run"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "arm": {"enum": ["worktrees", "awareness_only", "langspan", "shared"]},
    "family": {"enum": ["rename_vs_new_caller", "contradictory_defaults", "discovered_change"]},
    "sessions": {"enum": [2, 5, 10]},
    "seed": {"type": "integer", "minimum": 0},
    "agent": {"enum": ["standin", "claude-code"]},
    "dry_run": {"type": "boolean"},
    "standin_mode": {"enum": ["follow", "ignore", "hedge", "workaround"]},
    "status": {"enum": ["succeeded", "failed", "timed_out", "setup_failed", "interrupted", "refused"]},
    "started_at": {"type": "string"},
    "elapsed_s": {"type": ["number", "null"], "minimum": 0},
    "total_elapsed_s": {"type": "number", "minimum": 0},
    "time_limit_s": {"type": "number", "minimum": 0},
    "ignored_options": {"type": "array", "items": {"type": "string"}},
    "isolation": {"enum": ["clone", "worktree", "shared"]},
    "stagger_s": {
      "description": "Seconds the sessions other than the one whose task changes an interface waited to start; 0 when all started at once.",
      "type": "number", "minimum": 0
    },
    "auto_memory": {
      "description": "off: every Claude Code session ran with auto memory turned off; not_applicable: the stand-in, which has none.",
      "enum": ["off", "not_applicable"]
    },
    "tool_check": {
      "description": "The tool guard over every session: failed when any session was offered or called a tool outside its arm's set; passed only when every session passed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_sessions"],
      "properties": {
        "status": {"enum": ["passed", "failed", "unknown"]},
        "failed_sessions": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_cli", "requested_model", "models", "langspan_commit", "langspan_binary_sha256", "git", "python"],
      "properties": {
        "agent_cli": {"type": ["string", "null"]},
        "requested_model": {"type": ["string", "null"]},
        "models": {"type": "array", "items": {"type": "string"}},
        "langspan_commit": {"type": ["string", "null"]},
        "langspan_binary_sha256": {"type": ["string", "null"]},
        "git": {"type": ["string", "null"]},
        "python": {"type": "string"}
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session", "task_id", "role", "branch", "process_status", "merged", "completed",
          "accepted", "detail", "stopped", "asked_question", "results", "tool_check", "permission_denials",
          "tokens", "cost_usd", "duration_ms", "turns", "refusals", "interface_notices", "context_added", "transcript",
          "hook_log", "standin_informed", "notice_before_write", "pushes"
        ],
        "properties": {
          "session": {"type": "integer", "minimum": 1},
          "task_id": {"type": "string"},
          "role": {"enum": ["rename", "new_caller", "contradiction", "control", "changer", "dependent"]},
          "branch": {"type": "string"},
          "process_status": {"type": ["string", "null"]},
          "merged": {"type": "boolean"},
          "completed": {"type": ["boolean", "null"]},
          "accepted": {"type": ["boolean", "null"]},
          "detail": {"type": ["string", "null"]},
          "stopped": {"type": ["boolean", "null"]},
          "asked_question": {"type": ["boolean", "null"]},
          "results": {"type": ["integer", "null"], "minimum": 0},
          "tool_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "unexpected"],
            "properties": {
              "status": {"enum": ["passed", "failed", "unknown"]},
              "unexpected": {"type": "array", "items": {"type": "string"}}
            }
          },
          "permission_denials": {"$ref": "#/$defs/denials"},
          "tokens": {"$ref": "#/$defs/tokens"},
          "cost_usd": {"type": ["number", "null"], "minimum": 0},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0},
          "turns": {"type": ["integer", "null"], "minimum": 0},
          "refusals": {"type": ["integer", "null"], "minimum": 0},
          "interface_notices": {"type": ["integer", "null"], "minimum": 0},
          "context_added": {"$ref": "#/$defs/context"},
          "transcript": {"type": ["string", "null"]},
          "hook_log": {"type": ["string", "null"]},
          "standin_informed": {"type": ["boolean", "null"]},
          "notice_before_write": {
            "description": "LangSpan arm, a task that expects an interface notice: whether the hook log shows one in the session's context before its first Write, Edit or MultiEdit of a file its task owns. null when not measured: another arm, a task that expects none, or no such write.",
            "type": ["boolean", "null"]
          },
          "pushes": {
            "description": "Shared arm: the session's Bash calls that ran `git push` (attempts) and those whose result shows Git refusing the push (rejections), from its transcript. null in an arm whose sessions do not push, or with no transcript.",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["attempts", "rejections"],
            "properties": {
              "attempts": {"type": "integer", "minimum": 0},
              "rejections": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "pushes": {
      "description": "The tasks' push attempts and rejections summed. reported: every session's transcript was read; unknown when one was not, and not_applicable in an arm whose sessions do not push, both with null counts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempts", "rejections"],
      "properties": {
        "status": {"enum": ["reported", "unknown", "not_applicable"]},
        "attempts": {"type": ["integer", "null"], "minimum": 0},
        "rejections": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "tasks_total": {"type": "integer", "minimum": 1},
    "tasks_accepted": {"type": ["integer", "null"], "minimum": 0},
    "integrated_tests": {"enum": ["passed", "failed", "unknown"]},
    "interface_change": {
      "description": "discovered_change: made when the changer's own branch defines the helper in its changed, required form; change_not_made when it does not, and then no dependent is judged (completed and accepted null); unknown when the oracle did not run. not_applicable in the other families.",
      "enum": ["made", "change_not_made", "unknown", "not_applicable"]
    },
    "stale_callers": {
      "description": "discovered_change (stale_callers.py): from the changer's first admitted write that changes the helper, each admitted dependent write that leaves a call in the old form (writes_admitted), the dependent files with one (stale_files), those still stale at the session's end (unfixed), and the seconds from the change to the last stale caller fixed (fixed_after_s, null when none was stale or one stays stale). Each item is one file becoming stale at the change or by a write, or being fixed. unknown, with a reason, when a transcript, its file or a clock line is missing, or a committed file (any Python file the session added, changed or removed, as Git lists them) is not what the replayed Write and Edit calls left; not_applicable in other families and when the change was not made.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["reported", "unknown", "not_applicable"]},
        "reason": {"type": "string"},
        "writes_admitted": {"type": "integer", "minimum": 0},
        "stale_files": {"type": "integer", "minimum": 0},
        "unfixed": {"type": "integer", "minimum": 0},
        "fixed_after_s": {"type": ["number", "null"], "minimum": 0},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session", "path", "after_s", "kind"],
            "properties": {
              "session": {"type": "integer", "minimum": 1},
              "path": {"type": "string"},
              "after_s": {"type": "number", "minimum": 0},
              "kind": {"enum": ["stale_at_change", "stale_write", "fixed"]}
            }
          }
        }
      }
    },
    "merge_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session", "files"],
        "properties": {
          "session": {"type": "integer", "minimum": 1},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "semantic_conflicts": {"type": ["integer", "null"], "minimum": 0},
    "semantic_conflict_details": {"type": "array", "items": {"type": "string"}},
    "duplicate_work": {"type": ["integer", "null"], "minimum": 0},
    "duplicate_work_details": {"type": "array", "items": {"type": "string"}},
    "fixture_tests": {"enum": ["passed", "failed", "unknown"]},
    "stops": {"type": ["integer", "null"], "minimum": 0},
    "questions": {"type": ["integer", "null"], "minimum": 0},
    "permission_denials": {"$ref": "#/$defs/denials"},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "turns": {"type": ["integer", "null"], "minimum": 0},
    "refusals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count", "items", "sessions_registered", "admissions"],
      "properties": {
        "status": {"enum": ["reported", "not_applicable", "unknown"]},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "session", "kind", "paths", "peer_session", "followed_by"],
            "properties": {
              "seq": {"type": "integer", "minimum": 0},
              "session": {"type": ["integer", "null"], "minimum": 1},
              "kind": {"type": "string"},
              "paths": {"type": "array", "items": {"type": "string"}},
              "peer_session": {"type": ["string", "null"]},
              "followed_by": {"enum": ["admitted_later", "no_later_admission"]}
            }
          }
        },
        "sessions_registered": {"type": ["integer", "null"], "minimum": 0},
        "admissions": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "coordinator_scans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed", "recovered", "items"],
      "properties": {
        "status": {"enum": ["reported", "not_applicable", "unknown"]},
        "failed": {"type": ["integer", "null"], "minimum": 0},
        "recovered": {"type": ["integer", "null"], "minimum": 0},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session", "seq", "type", "detail"],
            "properties": {
              "session": {"type": "integer", "minimum": 1},
              "seq": {"type": "integer", "minimum": 0},
              "type": {"enum": ["scan_failed", "scan_recovered"]},
              "detail": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "context_added": {
      "description": "The context LangSpan's hooks added over every task. reported: every task was measured, and the figures are their sum; partial when some were and unknown when none were, both with every figure null; not_applicable in another arm. bytes_per_turn rounds down; estimated_tokens_per_turn is bytes_per_turn over four, rounded up, an estimate; largest_turn_bytes is the largest of any task's.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "turns", "bytes", "bytes_per_turn", "estimated_tokens_per_turn", "largest_turn_bytes"],
      "properties": {
        "status": {"enum": ["reported", "partial", "unknown", "not_applicable"]},
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "bytes_per_turn": {"type": ["integer", "null"], "minimum": 0},
        "estimated_tokens_per_turn": {"type": ["integer", "null"], "minimum": 0},
        "largest_turn_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "total"],
      "properties": {
        "status": {"enum": ["reported", "partial", "unknown"]},
        "total": {"$ref": "#/$defs/tokens"}
      }
    },
    "repair": {
      "description": "The repair round: one session in the combined tree of a trial whose combined result failed, asked to make it succeed, with the worktrees arm's tools and limits in every arm. not_needed: the combined result passed. ran: the session ran and the oracle judged the repaired tree. not_run: no round ran, for the reason given (refused, interrupted, no combined check, a failed tool check, change_not_made, or a harness error). Every figure is null unless the round ran.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "time_limit_s", "elapsed_s", "process_status", "succeeded", "integrated_tests",
        "tasks_accepted", "fixture_tests", "semantic_conflicts", "conflicted_merges", "stopped", "asked_question",
        "results", "tool_check", "permission_denials", "tokens", "cost_usd", "duration_ms", "turns", "evidence"
      ],
      "properties": {
        "status": {"enum": ["not_needed", "ran", "not_run"]},
        "reason": {"type": ["string", "null"]},
        "time_limit_s": {"type": ["number", "null"], "minimum": 0},
        "elapsed_s": {"type": ["number", "null"], "minimum": 0},
        "process_status": {"type": ["string", "null"]},
        "succeeded": {
          "description": "Whether the oracle accepted the repaired tree; null when no round ran or the oracle did not run.",
          "type": ["boolean", "null"]
        },
        "integrated_tests": {"enum": ["passed", "failed", "unknown"]},
        "tasks_accepted": {"type": ["integer", "null"], "minimum": 0},
        "fixture_tests": {"enum": ["passed", "failed", "unknown"]},
        "semantic_conflicts": {"type": ["integer", "null"], "minimum": 0},
        "conflicted_merges": {
          "description": "Sessions whose merge Git refused; the repair tree keeps each with its conflict markers committed.",
          "type": "array", "items": {"type": "integer", "minimum": 1}
        },
        "stopped": {"type": ["boolean", "null"]},
        "asked_question": {"type": ["boolean", "null"]},
        "results": {"type": ["integer", "null"], "minimum": 0},
        "tool_check": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["status", "unexpected"],
          "properties": {
            "status": {"enum": ["passed", "failed", "unknown"]},
            "unexpected": {"type": "array", "items": {"type": "string"}}
          }
        },
        "permission_denials": {"$ref": "#/$defs/denials"},
        "tokens": {"$ref": "#/$defs/tokens"},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "runner_journal", "transcript", "oracle"],
          "properties": {
            "plan": {"type": ["string", "null"]},
            "runner_journal": {"type": ["string", "null"]},
            "transcript": {"type": ["string", "null"]},
            "oracle": {"type": ["string", "null"]}
          }
        }
      }
    },
    "cost": {
      "description": "The cost to a correct result. run: the sessions' figures (the record's tokens.total, turns and cost_usd). repair: the repair session's, zero when no repair was needed, null when one was needed and did not run. total: run plus repair, each figure null unless both have it. tasks_accepted: in the final tree, the repaired one when a round ran. correct_result: the combined result passed, or its repair did. cost_per_accepted_task: total cost_usd over tasks_accepted, null when either is null or no task was accepted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "repair", "total", "tasks_accepted", "correct_result", "cost_per_accepted_task"],
      "properties": {
        "run": {"$ref": "#/$defs/figures"},
        "repair": {"$ref": "#/$defs/figures"},
        "total": {"$ref": "#/$defs/figures"},
        "tasks_accepted": {"type": ["integer", "null"], "minimum": 0},
        "correct_result": {"type": ["boolean", "null"]},
        "cost_per_accepted_task": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "error": {"type": "string"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_journal", "plan", "integration", "oracle", "events", "notes", "merge_logs"],
      "properties": {
        "runner_journal": {"type": ["string", "null"]},
        "plan": {"type": "string"},
        "integration": {"type": ["string", "null"]},
        "oracle": {"type": ["string", "null"]},
        "events": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "merge_logs": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "context": {
      "description": "LangSpan arm: the context LangSpan's hooks added to a task's sessions, summed over every session registered from its checkout. turns: a session start or resume, and each prompt; bytes: text added over those turns, mid-turn notes included; bytes_per_turn: bytes over turns, rounded down, 0 with no turn; estimated_tokens_per_turn: bytes_per_turn over four, rounded up, an estimate and not a tokenizer's count; largest_turn_bytes: the most one turn added. null when not measured: another arm, the coordinator's state not read, no session registered from the checkout, or a malformed figure.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["turns", "bytes", "bytes_per_turn", "estimated_tokens_per_turn", "largest_turn_bytes"],
      "properties": {
        "turns": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "bytes_per_turn": {"type": "integer", "minimum": 0},
        "estimated_tokens_per_turn": {"type": "integer", "minimum": 0},
        "largest_turn_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "figures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "turns", "cost_usd"],
      "properties": {
        "tokens": {"$ref": "#/$defs/tokens"},
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "tokens": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["input", "output", "cache_creation", "cache_read"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "cache_creation": {"type": "integer", "minimum": 0},
        "cache_read": {"type": "integer", "minimum": 0}
      }
    },
    "denials": {
      "description": "Calls the agent host refused, once per tool call over every result line: peer_checkout aimed at another session's checkout, the run's other repositories, or another session's branch, all refs or the stash; outside_clone refused by the host as outside the session's own checkout; not_allowed for any other call outside the allowed tool list.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["total", "peer_checkout", "outside_clone", "not_allowed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "peer_checkout": {"type": "integer", "minimum": 0},
        "outside_clone": {"type": "integer", "minimum": 0},
        "not_allowed": {"type": "integer", "minimum": 0}
      }
    }
  }
}

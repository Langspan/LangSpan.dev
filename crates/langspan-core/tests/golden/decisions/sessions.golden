## register-api-verified
{
  "events": [
    {
      "type": "workspace_registered",
      "workspace": {
        "workspace_id": "api",
        "root": "/work/api",
        "verified_overlaps": [
          "app"
        ]
      }
    }
  ],
  "outcome": {
    "type": "workspace",
    "workspace": {
      "workspace_id": "api",
      "root": "/work/api",
      "verified_overlaps": [
        "app"
      ]
    }
  }
}

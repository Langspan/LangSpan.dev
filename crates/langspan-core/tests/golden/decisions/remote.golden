## observe-bob
{
  "events": [
    {
      "type": "remote_observed",
      "peer": {
        "workspace_id": "app",
        "publication": {
          "participant": "b0b00000000000000000000000000002",
          "name": "Bob",
          "sequence": 4,
          "work": [
            {
              "host": "codex",
              "session": "codex.bob",
              "branch_ref": "refs/heads/login",
              "summary": "Rename the login form",
              "editing": [
                "src/ui.rs"
              ],
              "recent": [
                "src/api.rs"
              ]
            }
          ]
        },
        "received_ms": 3000,
        "generation": 1
      }
    }
  ],
  "outcome": {
    "type": "remote_observed",
    "participant": "b0b00000000000000000000000000002",
    "accepted": true
  }
}

## auto-check-enable
{
  "events": [
    {
      "type": "auto_check_enabled",
      "check": {
        "workspace_id": "app",
        "name": "unit",
        "argv": [
          "cargo",
          "test"
        ],
        "timeout_s": 600
      }
    }
  ],
  "outcome": {
    "type": "auto_check",
    "check": {
      "workspace_id": "app",
      "name": "unit",
      "argv": [
        "cargo",
        "test"
      ],
      "timeout_s": 600
    }
  }
}
## auto-check-enable-empty-argv
{
  "events": [],
  "outcome": {
    "type": "error",
    "code": "invalid_check",

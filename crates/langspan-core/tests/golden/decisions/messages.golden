## send-bob-to-alice
{
  "events": [
    {
      "type": "message_sent",
      "message": {
        "message_id": "send-bob-to-alice",
        "workspace_id": "app",
        "from": "codex.bob",
        "to": {
          "kind": "session",
          "session_id": "claude-code.alice"
        },
        "text": "The session handler now returns a Result",
        "paths": [
          "src/api.rs"
        ]
      },
      "at_ms": 2000,
      "generation": 1
    }
  ],
  "outcome": {
    "type": "message_sent",
    "message": {
      "message_id": "send-bob-to-alice",
      "workspace_id": "app",
      "from": "codex.bob",
      "to": {
        "kind": "session",
        "session_id": "claude-code.alice"
      },
      "text": "The session handler now returns a Result",
      "paths": [
        "src/api.rs"
      ]
    }
  }
}

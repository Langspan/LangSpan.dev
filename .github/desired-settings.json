{
  "_comment": [
    "The GitHub settings and rulesets the owner chose for this repository.",
    "scripts/github-drift.py compares them with the live values and changes nothing.",
    "Change a setting on GitHub and here in the same pull request. No token or secret value belongs here."
  ],
  "actions_permissions": {
    "allowed_actions": "all",
    "enabled": true,
    "sha_pinning_required": false
  },
  "automated_security_fixes": {
    "enabled": true,
    "paused": false
  },
  "code_scanning_default_setup": {
    "state": "not-configured"
  },
  "private_vulnerability_reporting": {
    "enabled": true
  },
  "repo": {
    "allow_auto_merge": true,
    "allow_merge_commit": true,
    "allow_rebase_merge": true,
    "allow_squash_merge": true,
    "default_branch": "main",
    "delete_branch_on_merge": false,
    "has_discussions": true,
    "has_issues": true,
    "has_projects": true,
    "has_wiki": true,
    "visibility": "public",
    "web_commit_signoff_required": false
  },
  "repository": "Langspan/LangSpan.dev",
  "rulesets": {
    "main": {
      "bypass_actors": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "pull_request"
        }
      ],
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "~DEFAULT_BRANCH"
          ]
        }
      },
      "enforcement": "active",
      "rules": {
        "deletion": {},
        "merge_queue": {
          "check_response_timeout_minutes": 60,
          "grouping_strategy": "ALLGREEN",
          "max_entries_to_build": 5,
          "max_entries_to_merge": 5,
          "merge_method": "SQUASH",
          "min_entries_to_merge": 1,
          "min_entries_to_merge_wait_minutes": 0
        },
        "non_fast_forward": {},
        "pull_request": {
          "allowed_merge_methods": [
            "squash"
          ],
          "dismiss_stale_reviews_on_push": false,
          "dismissal_restriction": {
            "allowed_actors": [],
            "enabled": false
          },
          "require_code_owner_review": false,
          "require_extra_approval_for_unattributed_changes": true,
          "require_last_push_approval": false,
          "required_approving_review_count": 0,
          "required_review_thread_resolution": false,
          "required_reviewers": []
        },
        "required_status_checks": {
          "do_not_enforce_on_create": false,
          "required_status_checks": [
            {
              "context": "Linux"
            },
            {
              "context": "Workflows"
            },
            {
              "context": "Content"
            }
          ],
          "strict_required_status_checks_policy": false
        }
      },
      "target": "branch"
    },
    "release tags": {
      "bypass_actors": [
        {
          "actor_id": 5944827,
          "actor_type": "Integration",
          "bypass_mode": "always"
        }
      ],
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "refs/tags/v*"
          ]
        }
      },
      "enforcement": "active",
      "rules": {
        "creation": {},
        "deletion": {},
        "non_fast_forward": {},
        "update": {}
      },
      "target": "tag"
    }
  },
  "security_and_analysis": {
    "dependabot_security_updates": "enabled",
    "secret_scanning": "enabled",
    "secret_scanning_ai_detection": "disabled",
    "secret_scanning_delegated_alert_dismissal": "disabled",
    "secret_scanning_delegated_bypass": "disabled",
    "secret_scanning_non_provider_patterns": "disabled",
    "secret_scanning_push_protection": "enabled",
    "secret_scanning_validity_checks": "disabled"
  },
  "vulnerability_alerts": true,
  "workflow_permissions": {
    "can_approve_pull_request_reviews": true,
    "default_workflow_permissions": "read"
  }
}

#!/usr/bin/env bash
# A stand-in for gh, for the scripts/ci-main-red.py tests in
# tests/ci_workflows.rs, which copies it onto PATH. Every call is appended
# to $GH_STUB_LOG, and what a write reads on stdin to $GH_STUB_LOG.body.
# `gh api PATH` prints the file api/<PATH up to "?", with / . = turned into
# _>; `gh issue list` prints issue-list.json; `gh run download --pattern P
# --dir D` copies each fixture directory matching P into D, or fails with
# the text of $GH_STUB_OVERRIDE/download-error when that exists. The fixtures
# are in $GH_STUB_FIXTURES; a file in $GH_STUB_OVERRIDE wins over the one
# there, and with neither the call fails as an HTTP 404 does. When
# $GH_STUB_OVERRIDE holds FILE.flood (a byte count N), serving FILE then
# writes N more bytes to stdout and, once it has written them all, appends
# FILE to $GH_STUB_LOG.finished; with FILE.flood-stderr it writes N bytes to
# stderr instead and fails. As gh does, `gh api` refuses a response holding
# an escape byte unless the call passes --allow-escape-sequences. A run
# download takes the matching directories in $GH_STUB_OVERRIDE when there
# are any. `gh workflow run` succeeds, or fails with the text of
# $GH_STUB_OVERRIDE/dispatch-error when that exists. `gh api --help` lists
# --allow-escape-sequences; with $GH_STUB_OVERRIDE/old-gh the stub is an
# older gh instead, whose help lacks the flag, which rejects it as unknown
# and which passes escape bytes through.
set -euo pipefail
here=$GH_STUB_FIXTURES
over=${GH_STUB_OVERRIDE:-/nonexistent}
printf '%s\n' "$*" >>"$GH_STUB_LOG"
old=0
if [ -f "$over/old-gh" ]; then old=1; fi
allow_escapes=$old
for arg in "$@"; do
  if [ "$arg" = --allow-escape-sequences ]; then
    if [ "$old" = 1 ]; then
      echo "unknown flag: --allow-escape-sequences" >&2
      exit 1
    fi
    allow_escapes=1
  fi
done
if [ "$1 ${2:-}" = "api --help" ]; then
  echo "Usage:  gh api <endpoint> [flags]"
  if [ "$old" = 0 ]; then
    echo "      --allow-escape-sequences   Keep terminal escape sequences in the output"
  fi
  exit 0
fi

flood() {
  local over=${GH_STUB_OVERRIDE:-/nonexistent}
  if [ -f "$over/$1.flood" ]; then
    { yes "filler line" || true; } | head -c "$(cat "$over/$1.flood")"
    printf '%s\n' "$1" >>"$GH_STUB_LOG.finished"
  fi
  if [ -f "$over/$1.flood-stderr" ]; then
    { yes "noise line" || true; } | head -c "$(cat "$over/$1.flood-stderr")" >&2
    exit 1
  fi
}

serve() {
  for dir in "${GH_STUB_OVERRIDE:-}" "$here"; do
    if [ -n "$dir" ] && [ -f "$dir/$1" ]; then
      if [ "$allow_escapes" = 0 ] && grep -q "$(printf '\033')" "$dir/$1"; then
        echo "the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway" >&2
        exit 1
      fi
      cat "$dir/$1"
      flood "$1"
      return 0
    fi
  done
  echo "gh stub: HTTP 404: no fixture $1" >&2
  exit 1
}

case "$1 ${2:-}" in
  "api "*)
    path=${2%%\?*}
    serve "api/$(printf '%s' "$path" | tr '/.=' '___')"
    ;;
  "issue list") serve issue-list.json ;;
  "run download")
    if [ -f "${GH_STUB_OVERRIDE:-}/download-error" ]; then
      cat "$GH_STUB_OVERRIDE/download-error" >&2
      exit 1
    fi
    pattern="" dest=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --pattern) pattern=$2; shift ;;
        --dir) dest=$2; shift ;;
      esac
      shift
    done
    found=0
    for dir in "$over"/$pattern; do
      if [ -d "$dir" ]; then cp -R "$dir" "$dest/"; found=1; fi
    done
    if [ "$found" = 0 ]; then
      for dir in "$here"/$pattern; do
        if [ -d "$dir" ]; then cp -R "$dir" "$dest/"; found=1; fi
      done
    fi
    if [ "$found" = 0 ]; then
      echo "no valid artifacts found to download" >&2
      exit 1
    fi
    ;;
  "issue create" | "issue comment")
    cat >>"$GH_STUB_LOG.body"
    echo "https://github.com/o/r/issues/7"
    ;;
  "issue close" | "label create") ;;
  "workflow run")
    if [ -f "$over/dispatch-error" ]; then
      cat "$over/dispatch-error" >&2
      exit 1
    fi
    ;;
  *)
    echo "gh stub: unexpected call: $*" >&2
    exit 2
    ;;
esac
